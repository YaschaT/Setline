// Copy to Setline.xcconfig and fill in. Both values are public by design —
// they are already inlined into the web bundle — but they stay out of Git so
// a fork does not inherit this project's Supabase instance.
//
// They are the same two values the web app reads from .env.local as
// NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
//
// The URL is written without its scheme because // starts a comment in
// xcconfig; SupabaseConfig adds https:// back.
SUPABASE_URL = your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
