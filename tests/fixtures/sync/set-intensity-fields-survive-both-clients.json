{
  "name": "A set's side, failed mark and drop set survive iOS writing them and the web editing the set",
  "why": "iOS writes side, failed and drops on a set. The web never models them: its session editor copies each set whole, so changing the weight keeps them, and the merge never removes a field it does not know.",
  "steps": [
    {
      "client": "ios",
      "now": "2026-10-13T18:05:00.000Z",
      "remote": { "sessions": [] },
      "ops": [
        { "kind": "upsertSession", "createdAt": "2026-10-13T18:00:00Z",
          "session": { "id": "s-20", "date": "2026-10-13T16:00:00.000Z", "dayId": "pull", "dayLabel": "Pull", "completion": 100,
            "results": [{ "exerciseId": "kneeling-lat", "name": "Kneeling lat pulldown",
              "sets": [
                { "weight": "30", "reps": "10", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false, "side": "L", "failed": true },
                { "weight": "30", "reps": "10", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false, "side": "R", "rir": 0,
                  "drops": [{ "weight": "22.5", "reps": "8" }] }
              ] }] } }
      ],
      "expected": {
        "sessions": [
          { "id": "s-20", "date": "2026-10-13T16:00:00.000Z", "dayId": "pull", "dayLabel": "Pull", "completion": 100,
