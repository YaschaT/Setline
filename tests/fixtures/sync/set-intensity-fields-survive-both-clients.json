              "sets": [
                { "weight": "32.5", "reps": "10", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false, "side": "L", "failed": true },
                { "weight": "30", "reps": "10", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false, "side": "R", "rir": 0,
