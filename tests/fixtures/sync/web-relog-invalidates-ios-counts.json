                { "weight": "100", "reps": "6", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false, "rir": 1, "origin": "sessionAdded" },
                { "weight": "100", "reps": "5", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false }
              ] }] }
