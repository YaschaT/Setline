            "results": [{ "exerciseId": "flat-bench", "name": "Flat bench press",
              "sets": [{ "weight": "100", "reps": "6", "pausedReps": "", "pauseSeconds": "", "pauseEnabled": false, "rir": 1, "origin": "sessionAdded" }] }],
            "durationSeconds": 2700, "note": "Goed", "iosPlannedSetCount": 3, "iosCompletedSetCount": 3, "futureField": true }
        ]
